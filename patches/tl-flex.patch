+    /// Unraid packaging: L-Connect polls a TL Flex receiver with GetInfo once a
+    /// second, and on every third poll sends opcode 0x08 with a clock just ahead
+    /// of the receiver's own (status bytes 15..19). Without that traffic the
+    /// Flex LCD stops answering USB a few seconds after the host first talks to
+    /// it. LIANLI_FLEX_KEEPALIVE=0 turns this off.
+    fn start_flex_keepalive(ctrl: &Arc<Self>) {
+        if !matches!(ctrl.pid, 0x0102 | 0x0104)
+            || std::env::var("LIANLI_FLEX_KEEPALIVE").is_ok_and(|value| value.trim() == "0")
+        {
+            return;
+        }
+        let weak = Arc::downgrade(ctrl);
+        let name = ctrl.params.name;
+        let spawned = std::thread::Builder::new()
+            .name("flex-keepalive".into())
+            .spawn(move || {
+                let mut tick: u32 = 0;
+                loop {
+                    if lianli_transport::usb::shutting_down() {
+                        break;
+                    }
+                    let Some(ctrl) = weak.upgrade() else { break };
+                    if !ctrl.is_wireless.load(Ordering::Relaxed) {
+                        if let Err(error) = ctrl.flex_keepalive_tick(tick) {
+                            debug!("{name}: keepalive failed: {error}");
+                        }
+                    }
+                    drop(ctrl);
+                    tick = tick.wrapping_add(1);
+                    std::thread::sleep(Duration::from_secs(1));
+                }
+            });
+        match spawned {
+            Ok(_) => info!("{name}: keepalive started"),
+            Err(error) => warn!("{name}: cannot start keepalive: {error}"),
+        }
+    }
+
+    fn flex_keepalive_tick(&self, tick: u32) -> Result<()> {
+        let Some(transport) = self.transport.try_lock_for(Duration::from_millis(500)) else {
+            return Ok(());
+        };
+        let mut tx = [0u8; PACKET_SIZE];
+        tx[0] = CMD_GET_INFO;
+        transport.write_full(&tx, LCD_WRITE_TIMEOUT)?;
+        let mut rx = [0u8; PACKET_SIZE];
+        let len = transport.read(&mut rx, LCD_READ_TIMEOUT)?;
+        if tick % 3 != 0 || len < 19 || rx[0] != CMD_GET_INFO {
+            return Ok(());
+        }
+        let clock = u32::from_be_bytes([rx[15], rx[16], rx[17], rx[18]]).wrapping_add(1000);
+        let mut tx = [0u8; PACKET_SIZE];
+        tx[0] = CMD_HOST_CLOCK;
+        tx[1..5].copy_from_slice(&clock.to_be_bytes());
+        transport.write_full(&tx, LCD_WRITE_TIMEOUT)?;
+        let _ = transport.read(&mut rx, LCD_READ_TIMEOUT);
+        debug!("{}: sent host clock {clock:#010x}", self.params.name);
+        Ok(())
+    }
