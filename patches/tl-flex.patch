+/// Unraid packaging: the fan-LCD firmware on TL Flex screens shares the wireless
+/// LCD's 100 KiB frame buffer, so frames are kept under it. Both limits can be
+/// changed with LIANLI_FLEX_JPEG_QUALITY and LIANLI_FLEX_MAX_PAYLOAD.
+impl ScreenInfo {
+    pub fn flex_lcd() -> Self {
+        let setting = |name: &str| {
+            std::env::var(name)
+                .ok()
+                .and_then(|value| value.trim().parse::<usize>().ok())
+        };
+        let mut screen = Self::FLEX_LCD;
+        screen.jpeg_quality = setting("LIANLI_FLEX_JPEG_QUALITY")
+            .map_or(85, |quality| quality.clamp(10, 100) as u8);
+        screen.max_payload = setting("LIANLI_FLEX_MAX_PAYLOAD")
+            .map_or(102_400 - 512, |size| size.clamp(16_384, 512_000));
+        // L-Connect never lets the panel go quiet, so re-send unchanged frames.
+        screen.needs_keepalive = true;
+        screen
+    }
+}
